DELETE {{host}}/api/patients/2/emergency-contact

# ======================= APPOINTMENTS =======================

### 31. Create first appointment: patient 1 (Szymon), doctor 1 (Adam) - (expected: 201 Created)
POST {{host}}/api/appointments
Content-Type: application/json
Accept: application/json

{
  "patientId": 1,
  "doctorId": 1,
  "scheduledAt": "2027-06-15T09:00:00+02:00",
  "durationMinutes": 30,
  "description": "Konsultacja kardiologiczna"
}

### 32. Create second appointment: patient 2 (Anna), doctor 2 (Zofia) - (expected: 201 Created)
POST {{host}}/api/appointments
Content-Type: application/json
Accept: application/json

{
  "patientId": 2,
  "doctorId": 2,
  "scheduledAt": "2027-06-15T10:00:00+02:00",
  "durationMinutes": 30,
  "description": "Konsultacja dermatologiczna"
}

### 33. Get first appointment by id - (expected: 200 OK)
GET {{host}}/api/appointments/1
Accept: application/json

### 34. Get all appointments - (expected: 200 OK, 2 appointments)
GET {{host}}/api/appointments
Accept: application/json

### 35. Update first appointment: reschedule - (expected: 204 No Content)
PUT {{host}}/api/appointments/1
Content-Type: application/json

{
  "doctorId": 1,
  "scheduledAt": "2027-06-15T11:30:00+02:00",
  "durationMinutes": 45,
  "description": "Konsultacja kardiologiczna - zmieniony termin"
}

### 36. Get updated first appointment - (expected: 200 OK)
GET {{host}}/api/appointments/1
Accept: application/json

### 37. Get patient 1 appointments - (expected: 200 OK)
GET {{host}}/api/patients/1/appointments
Accept: application/json

### 38. Get patient 2 appointments - (expected: 200 OK)
GET {{host}}/api/patients/2/appointments
Accept: application/json

### 39. Get doctor 1 appointments - (expected: 200 OK)
GET {{host}}/api/doctors/1/appointments
Accept: application/json

### 40. Get doctor 2 appointments - (expected: 200 OK)
GET {{host}}/api/doctors/2/appointments
Accept: application/json

### 41. Create third appointment: patient 2 (Anna), doctor 1 (Adam) - (expected: 201 Created)
POST {{host}}/api/appointments
Content-Type: application/json
Accept: application/json

{
  "patientId": 2,
  "doctorId": 1,
  "scheduledAt": "2027-06-16T14:00:00+02:00",
  "durationMinutes": 30,
  "description": "Kontrola kardiologiczna"
}

### 42. Cancel third appointment - (expected: 200 OK, status Cancelled)
PUT {{host}}/api/appointments/3/status?status=Cancelled
Accept: application/json

### 43. Get cancelled third appointment - (expected: 200 OK, status Cancelled)
GET {{host}}/api/appointments/3
Accept: application/json

